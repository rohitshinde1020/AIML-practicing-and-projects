    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "le = LabelEncoder()\n",
    "\n",
    "df[\"variety\"] = le.fit_transform(df[\"variety\"])\n",
    "\n",
    "df.head()"
   ]
